# Copiar a .env.local y llenar. Los mismos valores que usa la app Flutter en
# config/supabase.json (Supabase → Project Settings → API Keys).
#
# La llave publicable es pública por diseño: va dentro del navegador y lo que
# protege los datos es RLS. Se mantiene fuera del repo para poder rotarla.
#
# NUNCA pongas acá la llave `service_role`: se salta RLS por completo y este
# sitio está construido para no necesitarla.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Llave SECRETA (Supabase → Project Settings → API Keys → Secret keys).
# Empieza con sb_secret_. Solo la usa el servidor, para crear cuentas de
# pacientes y asignarles contraseña: son cosas que la Admin API exige y que no
# se pueden hacer con RLS.
#
# SIN prefijo NEXT_PUBLIC_, a propósito: con ese prefijo Next la metería en el
# paquete que descarga el navegador, y esta llave se salta RLS por completo.
SUPABASE_SECRET_KEY=sb_secret_...
